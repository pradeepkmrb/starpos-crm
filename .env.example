# Postgres
DATABASE_URL="postgresql://starpos_crm:starpos_crm@localhost:5432/starpos_crm?schema=public"

# Redis
REDIS_URL="redis://localhost:6379"

# API
API_PORT=4000
# Per-key ceiling for the public /api/v1 surface (optional; defaults to 120)
PUBLIC_API_RATE_LIMIT_PER_MINUTE=120
JWT_ACCESS_SECRET="change-me-access-secret"
JWT_REFRESH_SECRET="change-me-refresh-secret"

# Web
NEXT_PUBLIC_API_URL="http://localhost:4000"

# Meta WhatsApp Cloud API (Tech Provider app)
# The App ID and App Secret are configured per-platform in the
# /dashboard/platform-admin UI (stored encrypted in the DB), not here.
META_WEBHOOK_VERIFY_TOKEN="change-me-verify-token"

# Encryption key for per-tenant WABA access tokens (32-byte hex for AES-256-GCM)
TOKEN_ENCRYPTION_KEY=""

# Razorpay
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# Error monitoring (optional — leave blank to disable, no signup required to run the app)
SENTRY_DSN=""
